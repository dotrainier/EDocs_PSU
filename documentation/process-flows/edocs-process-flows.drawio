        <mxCell id="msg-n-M1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;M1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student writes a message on their request page&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="201" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="msg-n-M2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;M2&lt;/span&gt;&lt;br&gt;Signed in, and the request is theirs?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="465" y="162" width="230" height="136" as="geometry"/></mxCell>
