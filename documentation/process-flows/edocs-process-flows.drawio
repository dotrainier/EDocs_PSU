  </diagram>
  <diagram id="gaps" name="Gaps &amp; unclear behaviour">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1745" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="gaps-title" value="Gaps &amp;amp; unclear behaviour" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="gaps-subtitle" value="Everything found in the code that is not part of the intended flow, in one place. None of it is drawn on the flow tabs — “Where in the flow” names the tab and step ID so each item can be located there. Numbers match README.md." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1520" height="44" as="geometry"/></mxCell>
        <mxCell id="gaps-c0" value="24 items · Missing feature 6 · Security 4 · Data integrity 3 · Usability 2 · Bug 2 · Unclear intent 2 · Breaks the lifecycle 1 · Validation 1 · Breaks the lifecycle (latent) 1 · Data retention 1 · Reliability 1" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#1F3A5F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="1520" height="26" as="geometry"/></mxCell>
        <mxCell id="gaps-c1" value="#" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DCE6F2;fontStyle=1;fontSize=12;fontColor=#1F3A5F;align=center;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="50" height="34" as="geometry"/></mxCell>
        <mxCell id="gaps-c2" value="Gap or unclear behaviour" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DCE6F2;fontStyle=1;fontSize=12;fontColor=#1F3A5F;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="610" height="34" as="geometry"/></mxCell>
        <mxCell id="gaps-c3" value="Type" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DCE6F2;fontStyle=1;fontSize=12;fontColor=#1F3A5F;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="170" height="34" as="geometry"/></mxCell>
        <mxCell id="gaps-c4" value="Where in the flow (tab › step)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DCE6F2;fontStyle=1;fontSize=12;fontColor=#1F3A5F;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="150" width="240" height="34" as="geometry"/></mxCell>
        <mxCell id="gaps-c5" value="Evidence (source file : lines)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DCE6F2;fontStyle=1;fontSize=12;fontColor=#1F3A5F;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="150" width="450" height="34" as="geometry"/></mxCell>
        <mxCell id="gaps-c6" value="&lt;b&gt;1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="50" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c7" value="&lt;b&gt;“In Process” and “Cancelled” are never set&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Both statuses appear in filters, badges and the expected-date queue, but no code path assigns them (Cancel is offered only for Pending / In Process and does nothing). Requests go Pending → Ready for Release (or Action Required) → Released.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="184" width="610" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c8" value="Breaks the lifecycle" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#E1D5E7;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="184" width="170" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c9" value="0 · Overview › O6" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="184" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c10" value="src/lib/expected-date.ts:8&lt;br&gt;src/app/(portal)/requests/[id]/page.tsx:271" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="184" width="450" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c11" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="50" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c12" value="&lt;b&gt;Student is not told about Ready for Release or Released&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;No notification or email is created at either status change; the student only learns it by opening the request page. The last clearance notice says the office “cleared” the request, not that it is ready for pickup.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="255" width="610" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c13" value="Missing feature" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#EEEEEE;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="255" width="170" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c14" value="0 · Overview › O14&lt;br&gt;5 · Generate &amp;amp; release › D17&lt;br&gt;5 · Generate &amp;amp; release › D1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="255" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c15" value="src/lib/routing.ts:58-67&lt;br&gt;src/app/api/office/requests/[id]/release/route.ts:48-58" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="255" width="450" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c16" value="&lt;b&gt;3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="50" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c17" value="&lt;b&gt;Decisions are not guarded against repeats or reversal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The approve/reject endpoint never checks the current status: re-approving or re-rejecting writes another audit entry and sends another email. It also accepts “pending”, which moves an account back to pending with no audit entry and no email.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="326" width="610" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c18" value="Data integrity" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DAE8FC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="326" width="170" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c19" value="1 · Registration &amp;amp; approval › R11" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="326" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c20" value="src/app/api/admin/users/[id]/route.ts:70-74&lt;br&gt;src/app/api/admin/users/[id]/route.ts:107-126" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="326" width="450" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c21" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="397" width="50" height="85" as="geometry"/></mxCell>
        <mxCell id="gaps-c22" value="&lt;b&gt;Account status is revealed before the password is checked&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Pending / rejected / deactivated checks run before the password comparison, so anyone can learn whether an email or Student ID is registered and its review state without knowing the password. The two “wrong login” messages also differ (“Invalid username or password” vs “Invalid credentials”).&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="397" width="610" height="85" as="geometry"/></mxCell>
        <mxCell id="gaps-c23" value="Security" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#F8CECC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="397" width="170" height="85" as="geometry"/></mxCell>
        <mxCell id="gaps-c24" value="2 · Sign-in &amp;amp; sign-out › S4" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="397" width="240" height="85" as="geometry"/></mxCell>
        <mxCell id="gaps-c25" value="src/app/api/auth/signin/route.ts:56-88" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="397" width="450" height="85" as="geometry"/></mxCell>
        <mxCell id="gaps-c26" value="&lt;b&gt;5&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c27" value="&lt;b&gt;Nothing can deactivate an account&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;No endpoint changes an account’s active status, so the “deactivated” branch is only reachable by editing the database directly.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="482" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c28" value="Missing feature" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#EEEEEE;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="482" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c29" value="2 · Sign-in &amp;amp; sign-out › S6" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="482" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c30" value="src/app/api/auth/signin/route.ts:77-82&lt;br&gt;src/app/api/auth/refresh/route.ts:47" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="482" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c31" value="&lt;b&gt;6&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="539" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c32" value="&lt;b&gt;Return address is ignored&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The access guard (page 2b) adds ?next=&amp;lt;page&amp;gt; when it sends a user to sign in, but the sign-in page ignores it and always opens the role dashboard.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="539" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c33" value="Usability" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFF2CC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="539" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c34" value="2 · Sign-in &amp;amp; sign-out › S9" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="539" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c35" value="src/proxy.ts:66&lt;br&gt;src/app/(auth)/signin/page.tsx:46-47" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="539" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c36" value="&lt;b&gt;7&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="596" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c37" value="&lt;b&gt;The “/verify” page does not exist&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The guard treats /verify as public and the home page links to it for QR document verification, but no /verify page exists (and no QR or hash-verification code), so the link shows “not found”.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="596" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c38" value="Missing feature" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#EEEEEE;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="596" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c39" value="2b · Page access &amp;amp; session renewal › A2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="596" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c40" value="src/proxy.ts:10&lt;br&gt;src/app/page.tsx:141" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="596" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c41" value="&lt;b&gt;8&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="653" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c42" value="&lt;b&gt;Deactivated users are sent to a page that does not exist&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Renewal redirects a deactivated account (and any unexpected renewal error) to /login, but the sign-in page is /signin, so the user lands on “not found”.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="653" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c43" value="Bug" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFE6CC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="653" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c44" value="2b · Page access &amp;amp; session renewal › A11" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="653" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c45" value="src/app/api/auth/refresh/route.ts:50&lt;br&gt;src/app/api/auth/refresh/route.ts:73" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="653" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c46" value="&lt;b&gt;9&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c47" value="&lt;b&gt;Renewal ignores registration status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Only the active flag is re-checked. An account moved back to pending or rejected after approval keeps renewing its session for up to 7 days.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="710" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c48" value="Security" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#F8CECC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="710" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c49" value="2b · Page access &amp;amp; session renewal › A11" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="710" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c50" value="src/app/api/auth/refresh/route.ts:25-51" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="710" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c51" value="&lt;b&gt;10&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="767" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c52" value="&lt;b&gt;Renewal stores officeId as the text “null”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;For a user with no office, the renewed access pass carries officeId = &quot;null&quot; (a string) instead of an empty value. Harmless today because the /office check looks at the role first.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="767" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c53" value="Bug" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFE6CC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="767" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c54" value="2b · Page access &amp;amp; session renewal › A12" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="767" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c55" value="src/app/api/auth/refresh/route.ts:56" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="767" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c56" value="&lt;b&gt;11&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="824" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c57" value="&lt;b&gt;AI checks are advisory only&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The checks run only in the browser before Step 3. The submit endpoint never re-checks the purpose, and “Continue anyway” always lets the student through.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="824" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c58" value="Unclear intent" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFF2CC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="824" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c59" value="3a · Request wizard › W6" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="824" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c60" value="src/app/(portal)/requests/new/_components/NewRequestClient.tsx:295-333&lt;br&gt;src/app/api/portal/requests/route.ts:94-211" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="824" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c61" value="&lt;b&gt;12&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="881" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c62" value="&lt;b&gt;A type-mismatch warning can be skipped silently&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;When the purpose is flagged, the type-match result is thrown away: “Continue anyway” goes straight to Step 3 without ever showing the mismatch or low-confidence warning.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="881" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c63" value="Usability" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFF2CC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="881" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c64" value="3a · Request wizard › W9" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="881" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c65" value="src/app/(portal)/requests/new/_components/NewRequestClient.tsx:313-316&lt;br&gt;src/app/(portal)/requests/new/_components/NewRequestClient.tsx:494" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="881" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c66" value="&lt;b&gt;13&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="938" width="50" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c67" value="&lt;b&gt;Submission skips the role-to-document permission check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The form lists only document types granted to the user’s role, but the submit endpoint checks only “active” and the enrolled-only rule, not those role grants. Harmless while every type is granted to Students.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="938" width="610" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c68" value="Validation" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFF2CC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="938" width="170" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c69" value="3b · Request submission › P4" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="938" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c70" value="src/app/api/portal/requests/route.ts:114-139&lt;br&gt;src/app/api/shared/document-types/route.ts:34-37" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="938" width="450" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c71" value="&lt;b&gt;14&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1009" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c72" value="&lt;b&gt;Tracking numbers can collide&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The number is “this year’s count + 1”. Two submissions at the same moment can get the same number; the unique constraint then rejects one of them with a 500 error.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1009" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c73" value="Data integrity" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DAE8FC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1009" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c74" value="3b · Request submission › P10" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1009" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c75" value="src/lib/generate.ts:8-14&lt;br&gt;src/db/schema/request.schema.ts:6" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1009" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c76" value="&lt;b&gt;15&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1066" width="50" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c77" value="&lt;b&gt;No transaction around the save&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The request, its clearance tasks and the audit entry are separate writes. If task creation fails, the request stays saved with no task, so no office queue shows it. A TOR form uploaded before a failed save is left orphaned in storage.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1066" width="610" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c78" value="Data integrity" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DAE8FC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1066" width="170" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c79" value="3b · Request submission › P13" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1066" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c80" value="src/app/api/portal/requests/route.ts:174-211" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1066" width="450" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c81" value="&lt;b&gt;16&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1137" width="50" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c82" value="&lt;b&gt;Types without clearance would be stranded&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;If a type did not require clearance, no task is created — and no other code moves the request forward or shows it to an office. All seeded types currently require clearance, so this path is latent.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1137" width="610" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c83" value="Breaks the lifecycle (latent)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#E1D5E7;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1137" width="170" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c84" value="3b · Request submission › P12" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1137" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c85" value="src/app/api/portal/requests/route.ts:202-204&lt;br&gt;src/app/api/office/requests/[id]/route.ts:117-124" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1137" width="450" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c86" value="&lt;b&gt;17&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1208" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c87" value="&lt;b&gt;Any involved office can confirm payment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Mark as Paid is accepted from any office with a Pending task on the request, not only the cashier or Registrar. Latent with the single-office seed data.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1208" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c88" value="Unclear intent" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFF2CC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1208" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c89" value="4 · Clearance &amp;amp; routing › C9" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1208" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c90" value="src/app/api/office/requests/[id]/payment/route.ts:40-59" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1208" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c91" value="&lt;b&gt;18&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1265" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c92" value="&lt;b&gt;Replaced clearance forms stay in storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Uploading a replacement TOR form points the request at the new file, but the old one is never deleted from Cloudinary — a personal document kept with nothing referencing it.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1265" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c93" value="Data retention" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#DAE8FC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1265" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c94" value="4b · Action Required &amp;amp; resubmission › X9" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1265" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c95" value="src/app/api/portal/requests/[id]/resubmit/route.ts:132-133&lt;br&gt;src/app/api/portal/requests/[id]/resubmit/route.ts:144&lt;br&gt;src/lib/cloudinary.ts:25-39" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1265" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c96" value="&lt;b&gt;19&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1322" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c97" value="&lt;b&gt;Generated certificate is a placeholder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The template only receives the generation date — no student name, course, grades or registration data — so every COE/COR/COG PDF is the same apart from the date.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1322" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c98" value="Missing feature" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#EEEEEE;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1322" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c99" value="5 · Generate &amp;amp; release › D5" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1322" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c100" value="src/lib/document-generation.ts:55-61" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1322" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c101" value="&lt;b&gt;20&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1379" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c102" value="&lt;b&gt;TOR has no production step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;TOR is configured as an “UPLOAD” type, but no endpoint lets staff upload or attach the finished transcript.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1379" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c103" value="Missing feature" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#EEEEEE;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1379" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c104" value="5 · Generate &amp;amp; release › D2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1379" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c105" value="src/db/seed/seed.document.ts:35&lt;br&gt;src/app/api/office/requests/[id]/document/route.ts:55-60" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1379" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c106" value="&lt;b&gt;21&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1436" width="50" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c107" value="&lt;b&gt;Student download is a stub without access control&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The download endpoint ignores the request ID, doesn’t check sign-in and always returns public/sample_cor.pdf. The request list shows the Download button for every Ready for Release / Released request.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1436" width="610" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c108" value="Security" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#F8CECC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1436" width="170" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c109" value="5 · Generate &amp;amp; release › D9" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1436" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c110" value="src/app/api/portal/documents/download/[id]/route.ts:4-13&lt;br&gt;src/app/api/portal/requests/route.ts:349" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1436" width="450" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c111" value="&lt;b&gt;22&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1507" width="50" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c112" value="&lt;b&gt;Release is not linked to the pickup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;The system doesn’t record who collected the document or when, and doesn’t require it before release; the admin’s click is the only evidence.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1507" width="610" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c113" value="Missing feature" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#EEEEEE;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1507" width="170" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c114" value="5 · Generate &amp;amp; release › D16" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1507" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c115" value="src/app/api/office/requests/[id]/release/route.ts:48-58" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1507" width="450" height="57" as="geometry"/></mxCell>
        <mxCell id="gaps-c116" value="&lt;b&gt;23&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1564" width="50" height="70" as="geometry"/></mxCell>
        <mxCell id="gaps-c117" value="&lt;b&gt;Notification endpoints don’t check who is asking&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Subscribe, list, mark-read and send all take a user ID or notice ID from the URL/body with no session check. Anyone can read another user’s notices, mark them read, or push fake live notices.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1564" width="610" height="70" as="geometry"/></mxCell>
        <mxCell id="gaps-c118" value="Security" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#F8CECC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1564" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="gaps-c119" value="6 · Messages &amp;amp; notifications › M20" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1564" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="gaps-c120" value="src/app/api/notifications/subscribe/route.ts:5&lt;br&gt;src/app/api/notifications/list/route.ts:8&lt;br&gt;src/app/api/notifications/[id]/read/route.ts:6-18&lt;br&gt;src/app/api/notifications/send/route.ts:11-21" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFFFFF;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1564" width="450" height="70" as="geometry"/></mxCell>
        <mxCell id="gaps-c121" value="&lt;b&gt;24&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1634" width="50" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c122" value="&lt;b&gt;Live delivery is fragile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Connections live in one server process’s memory, one per user (a newer tab replaces the older). Users on another instance, or offline, get nothing live. Message threads never update live — only after sending or pressing refresh.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1634" width="610" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c123" value="Reliability" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FFF2CC;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="1634" width="170" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c124" value="6 · Messages &amp;amp; notifications › M22" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="1634" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="gaps-c125" value="src/lib/notification-connections.ts:2&lt;br&gt;src/app/api/notifications/subscribe/route.ts:15&lt;br&gt;src/components/shared/MessageThreadPanel.tsx:75" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeColor=#BBBBBB;fillColor=#FAFBFD;fontSize=10.5;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1634" width="450" height="71" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
