        <mxCell id="ast-title" value="7 · Admin Assistant (AI questions over live data)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="ast-subtitle" value="How an administrator’s question is answered by the AI model using read-only lookups. Nothing is stored: the conversation lives only in the open page." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1330" height="44" as="geometry"/></mxCell>
        <mxCell id="ast-lane0" value="Admin" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="1217" as="geometry"/></mxCell>
        <mxCell id="ast-lane1" value="System" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="690" height="1217" as="geometry"/></mxCell>
        <mxCell id="ast-lane2" value="AI model (Gemini)" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="340" height="1217" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;Q1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Admin asks a question in the Assistant chat&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E3EAF4;&quot;&gt;the page sends the question + this visit’s conversation&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="188" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q2&lt;/span&gt;&lt;br&gt;Signed in as Admin?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="465" y="162" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ast-n-F1" value="&lt;b&gt;Refused (401 / 403)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="205" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q3" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q3&lt;/span&gt;&lt;br&gt;Question ≤ 1,000 chars and history valid? (≤ 40 turns, alternating)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="465" y="327" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ast-n-F2" value="&lt;b&gt;Refused (400)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="370" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q4" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q4&lt;/span&gt;&lt;br&gt;Asks for a forecast or prediction? (keyword patterns)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="465" y="492" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q4y" value="&lt;b&gt;Fixed reply: forecasting isn’t supported&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;offers current live figures instead&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="530.5" width="240" height="59" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q5&lt;/span&gt;&lt;br&gt;&lt;b&gt;Send the question to the AI model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;with the conversation, strict rules (numbers only from lookups · read-only · no forecasts) and 7 read-only lookups: overview, requests by status, by document type, backlog &amp;amp; capacity, payments, registration funnel, recent activity&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="660.5" width="240" height="149" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q6" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q6&lt;/span&gt;&lt;br&gt;&lt;b&gt;Model answers, or asks for lookups&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="706" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q7" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q7&lt;/span&gt;&lt;br&gt;Model asked for lookups?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="765" y="837" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q8" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q8&lt;/span&gt;&lt;br&gt;5 lookup rounds already used?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="765" y="1002" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q9" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q9&lt;/span&gt;&lt;br&gt;&lt;b&gt;Run the requested lookups on live data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;each result is a live snapshot, or an error note if the lookup fails&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="1183" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q10" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q10&lt;/span&gt;&lt;br&gt;Reply text empty?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="465" y="837" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ast-n-Q11" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;Q11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Answer shown&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;with the lookups that were used&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="877" width="240" height="56" as="geometry"/></mxCell>
