        <mxCell id="wiz-lt18" value="Refusal or failure outcome" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="398" width="232" height="30" as="geometry"/></mxCell>
