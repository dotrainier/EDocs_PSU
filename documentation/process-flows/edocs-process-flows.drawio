  <diagram id="clr" name="4 · Clearance &amp; routing">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="3403" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="clr-title" value="4 · Office processing: payment, clearance and routing" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="clr-subtitle" value="How office staff work a clearance task: confirm payment, clear or reject, and how the system routes the request to the next office or marks it Ready for Release. Seeded data uses one office (Registrar); the routing engine also supports parallel and sequential offices." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="44" as="geometry"/></mxCell>
        <mxCell id="clr-lane0" value="Student" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="3253" as="geometry"/></mxCell>
        <mxCell id="clr-lane1" value="Office Staff" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="300" height="3253" as="geometry"/></mxCell>
        <mxCell id="clr-lane2" value="System" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="920" height="3253" as="geometry"/></mxCell>
        <mxCell id="clr-n-C1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;C1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Staff opens the office queue&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="205" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="clr-n-C2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C2&lt;/span&gt;&lt;br&gt;&lt;b&gt;List this office’s Pending clearance tasks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;newest first · requestor, document, fee, payment status · expected date per request&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="181.5" width="240" height="97" as="geometry"/></mxCell>
        <mxCell id="clr-n-C3" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C3&lt;/span&gt;&lt;br&gt;&lt;b&gt;Opens a request&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="342" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="clr-n-C4" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C4&lt;/span&gt;&lt;br&gt;Staff’s office has a clearance task on this request?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="432" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-F1" value="&lt;b&gt;Refused: “Your office is not involved in this request”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="475" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="clr-n-C5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C5&lt;/span&gt;&lt;br&gt;&lt;b&gt;Show the request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;requestor, purpose, fee and payment status, every office’s task, audit timeline · TOR: the student’s clearance form, streamed after re-checking the office is involved · Registrar: academic-records summary&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="609.5" width="240" height="121" as="geometry"/></mxCell>
        <mxCell id="clr-n-C6" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C6&lt;/span&gt;&lt;br&gt;Payment still Unpaid?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="777" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-C7" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C7&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student pays the fee at the Registrar’s Office&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="816" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="clr-n-C8" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C8&lt;/span&gt;&lt;br&gt;&lt;b&gt;Clicks “Mark as Paid”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;button shown only while this office’s task is Pending&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="945.5" width="240" height="69" as="geometry"/></mxCell>
        <mxCell id="clr-n-C9" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C9&lt;/span&gt;&lt;br&gt;Office has a Pending task here, and not already paid?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1005" y="912" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-F2" value="&lt;b&gt;Refused (403 / 409)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="955" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="clr-n-C10" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C10&lt;/span&gt;&lt;br&gt;&lt;b&gt;Set payment = Paid&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;audit PAYMENT_CONFIRMED&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1102" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="clr-n-C11" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Adds remarks and clicks Clear or Reject&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Clear disabled until paid · Reject disabled until remarks are typed&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="1228" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="clr-n-C11b" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C11b&lt;/span&gt;&lt;br&gt;Rejecting without remarks?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="1352" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-F3" value="&lt;b&gt;Refused: “Remarks are required when rejecting a clearance”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="1395" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="clr-n-C12" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C12&lt;/span&gt;&lt;br&gt;Task is this office’s and still Pending?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="1517" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-F4" value="&lt;b&gt;Refused: not your office (403) or already resolved (409)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="1560" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="clr-n-C13" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C13&lt;/span&gt;&lt;br&gt;Clear or Reject?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="1682" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-C14" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C14&lt;/span&gt;&lt;br&gt;&lt;b&gt;Mark task Rejected and set request status = Action Required&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;remarks (the reason the student will see), staff member and time saved&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1700.5" width="240" height="99" as="geometry"/></mxCell>
        <mxCell id="clr-n-C15" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C15&lt;/span&gt;&lt;br&gt;Payment confirmed (Paid)?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="1847" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-F5" value="&lt;b&gt;Refused: “Payment has not been confirmed”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="1890" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="clr-n-C16" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C16&lt;/span&gt;&lt;br&gt;&lt;b&gt;Mark task Cleared&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;remarks, staff member and time saved&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="2037" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="clr-n-C17" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C17&lt;/span&gt;&lt;br&gt;Any task Rejected, or a parallel task still Pending?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="2147" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-C18" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C18&lt;/span&gt;&lt;br&gt;Another office next in sequence? (highest cleared + 1)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="2312" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-C19" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C19&lt;/span&gt;&lt;br&gt;&lt;b&gt;Create a Pending task for that office&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;it appears in that office’s queue and the flow repeats from C1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="2338" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="clr-n-C20" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C20&lt;/span&gt;&lt;br&gt;&lt;b&gt;Set request status = Ready for Release&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;audit REQUEST_READY_FOR_RELEASE&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="2499.5" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="clr-n-C21" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C21&lt;/span&gt;&lt;br&gt;&lt;b&gt;Write audit entry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;CLEARANCE_CLEARED or CLEARANCE_REJECTED, with remarks&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="2630.5" width="240" height="69" as="geometry"/></mxCell>
        <mxCell id="clr-n-C22" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C22&lt;/span&gt;&lt;br&gt;&lt;b&gt;Notify the student in the background&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;in-app notice + live push + email · Cleared: “cleared by &amp;lt;office&amp;gt;” · Rejected: “Action required on your &amp;lt;document&amp;gt; request” with the reason&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="2745" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="clr-n-C23" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C23&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student sees the decision and remark on the request page&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="2771" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="clr-n-C24" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C24&lt;/span&gt;&lt;br&gt;Request now Ready for Release?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="2897" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-C24y" value="&lt;b&gt;Continues on page 5 · Generate &amp;amp; release&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="2940" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="clr-n-C25" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C25&lt;/span&gt;&lt;br&gt;This task was rejected?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="725" y="3062" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="clr-n-C25y" value="&lt;b&gt;Request is in Action Required&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;continues on page 4b · Action Required &amp;amp; resubmission&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="3101.5" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="clr-n-C26" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;C26&lt;/span&gt;&lt;br&gt;&lt;b&gt;Request stays Pending&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;waits for the remaining or next office&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="3247" width="240" height="56" as="geometry"/></mxCell>
