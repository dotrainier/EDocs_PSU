  <diagram id="reg" name="1 · Registration &amp; approval">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1770" pageHeight="2309" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="reg-title" value="1 · Account registration and admin approval" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="reg-subtitle" value="How a student or alumnus creates an account, and how an administrator approves or rejects it. Sign-in is blocked until the account is approved." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1280" height="44" as="geometry"/></mxCell>
        <mxCell id="reg-lane0" value="Applicant" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="2159" as="geometry"/></mxCell>
        <mxCell id="reg-lane1" value="Admin" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="300" height="2159" as="geometry"/></mxCell>
        <mxCell id="reg-lane2" value="System" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="680" height="2159" as="geometry"/></mxCell>
        <mxCell id="reg-n-R1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;R1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Applicant opens the registration form&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="201" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="reg-n-R2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R2&lt;/span&gt;&lt;br&gt;&lt;b&gt;Chooses applicant type and fills in the form&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Enrolled student: 10-digit Student ID, year level, school email · Alumni: year graduated, email · Both: full name, course (or “Other” + note), password&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="325" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="reg-n-R3" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R3&lt;/span&gt;&lt;br&gt;Details valid?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="715" y="312" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="reg-n-F1" value="&lt;b&gt;Refused: first problem is shown&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;e.g. ID not 10 digits, password under 8 characters, future graduation year, course and “Other” both or neither given&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="338.5" width="240" height="83" as="geometry"/></mxCell>
        <mxCell id="reg-n-R4" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R4&lt;/span&gt;&lt;br&gt;Email (or Student ID) already registered?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="715" y="477" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="reg-n-F2" value="&lt;b&gt;Refused: “An account with this email or Student ID already exists”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="514.5" width="240" height="61" as="geometry"/></mxCell>
        <mxCell id="reg-n-R5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R5&lt;/span&gt;&lt;br&gt;Course picked from the list still exists and is active?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="715" y="642" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="reg-n-F3" value="&lt;b&gt;Refused: “Selected course is not available”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="685" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="reg-n-R6" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R6&lt;/span&gt;&lt;br&gt;&lt;b&gt;Create the account&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;password hashed · role = Student · verification = pending&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="830.5" width="240" height="69" as="geometry"/></mxCell>
        <mxCell id="reg-n-R7" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R7&lt;/span&gt;&lt;br&gt;&lt;b&gt;Applicant sees “submitted — pending review”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;cannot sign in yet&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="829.5" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="reg-n-R8" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;R8&lt;/span&gt;&lt;br&gt;&lt;b&gt;Admin opens Pending Registrations&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="981" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="reg-n-R9" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R9&lt;/span&gt;&lt;br&gt;&lt;b&gt;Reviews the applicant’s details&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="1101" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="reg-n-R10" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R10&lt;/span&gt;&lt;br&gt;Approve the registration?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="375" y="1212" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="reg-n-R11" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Set verification = approved&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;any earlier rejection reason is cleared&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="1252" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="reg-n-R12" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R12&lt;/span&gt;&lt;br&gt;&lt;b&gt;Types a rejection reason and confirms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Confirm is disabled until a reason is entered&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="1398" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="reg-n-R13" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R13&lt;/span&gt;&lt;br&gt;Reason provided?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="715" y="1372" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="reg-n-F4" value="&lt;b&gt;Refused: “A rejection reason is required”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="1415" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="reg-n-R14" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R14&lt;/span&gt;&lt;br&gt;&lt;b&gt;Set verification = rejected and save the reason&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="1571" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="reg-n-R15" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R15&lt;/span&gt;&lt;br&gt;&lt;b&gt;Write audit-log entry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;REGISTRATION_APPROVED or REGISTRATION_REJECTED, with applicant name, email and reason&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="1689" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="reg-n-R16" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R16&lt;/span&gt;&lt;br&gt;&lt;b&gt;Email the applicant in the background&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Approved: confirmation + sign-in link · Rejected: the reason · email failures are ignored&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="1821.5" width="240" height="97" as="geometry"/></mxCell>
        <mxCell id="reg-n-R17" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R17&lt;/span&gt;&lt;br&gt;Approved?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="715" y="1962" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="reg-n-R18" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R18&lt;/span&gt;&lt;br&gt;&lt;b&gt;Account approved — applicant can sign in&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="2001" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="reg-n-R19" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;R19&lt;/span&gt;&lt;br&gt;&lt;b&gt;Registration rejected — sign-in stays blocked&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="2151" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="reg-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg-n-R1" target="reg-n-R2"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="reg-e1" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg-n-R2" target="reg-n-R3"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="reg-e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;fontColor=#B85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg-n-R3" target="reg-n-F1"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
