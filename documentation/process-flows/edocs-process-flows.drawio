  </diagram>
  <diagram id="sub" name="3b · Request submission">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="2090" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="sub-title" value="3b · Submitting the request" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="sub-subtitle" value="What the system does when the student clicks “Submit Request”: re-validates everything, stores the clearance form (TOR), saves the request, creates clearance tasks and notifies everyone involved." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1250" height="44" as="geometry"/></mxCell>
        <mxCell id="sub-lane0" value="Student" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="1940" as="geometry"/></mxCell>
        <mxCell id="sub-lane1" value="System" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="950" height="1940" as="geometry"/></mxCell>
        <mxCell id="sub-n-P1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;P1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student submits the request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E3EAF4;&quot;&gt;from Step 4 (page 3a)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="202" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="sub-n-P2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P2&lt;/span&gt;&lt;br&gt;Signed in as a Student?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="162" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="sub-n-F1" value="&lt;b&gt;Refused (401 / 403)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="205" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="sub-n-P3" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P3&lt;/span&gt;&lt;br&gt;Input valid? (purpose ≤ 255 chars, copies 1–10)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="327" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="sub-n-F2" value="&lt;b&gt;Refused: “Invalid input”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="370" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="sub-n-P4" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P4&lt;/span&gt;&lt;br&gt;Document type exists and is active?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="492" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="sub-n-F3" value="&lt;b&gt;Refused: “Document type not found or inactive”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="535" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="sub-n-P5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P5&lt;/span&gt;&lt;br&gt;Enrolled-only type, but requester is an alumnus?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="657" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="sub-n-F4" value="&lt;b&gt;Refused: “only available to currently enrolled students”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="700" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="sub-n-P6" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P6&lt;/span&gt;&lt;br&gt;Past-term type (COG) without school year or semester?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="822" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="sub-n-F5" value="&lt;b&gt;Refused: “School year and semester are required”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="865" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="sub-n-P7" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P7&lt;/span&gt;&lt;br&gt;Transcript of Records (TOR)?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="987" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="sub-n-P8" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P8&lt;/span&gt;&lt;br&gt;Clearance form attached, PDF/JPG/PNG, ≤ 5 MB?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="987" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="sub-n-F6" value="&lt;b&gt;Refused: form missing, wrong type or too large&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="1030" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="sub-n-P9" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P9&lt;/span&gt;&lt;br&gt;&lt;b&gt;Upload the form to private cloud storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;only its file ID is kept with the request&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="1168" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="sub-n-P10" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P10&lt;/span&gt;&lt;br&gt;&lt;b&gt;Generate the tracking number&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;EDOC-&amp;lt;year&amp;gt;-&amp;lt;this year’s request count + 1, six digits&amp;gt;&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1295.5" width="240" height="69" as="geometry"/></mxCell>
        <mxCell id="sub-n-F7" value="&lt;b&gt;Any step: unexpected error (e.g. upload or database failure) → 500 with the error message&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="1299.5" width="240" height="61" as="geometry"/></mxCell>
        <mxCell id="sub-n-P11" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Save the request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;status = Pending · fee copied from the document type · payment = Unpaid if the fee is above 0, otherwise Paid · COG: school year + semester · TOR: form file ID&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1416" width="240" height="108" as="geometry"/></mxCell>
        <mxCell id="sub-n-P12" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P12&lt;/span&gt;&lt;br&gt;Type requires clearance?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="1572" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="sub-n-P13" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P13&lt;/span&gt;&lt;br&gt;&lt;b&gt;Create clearance tasks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;every parallel office (no sequence) → Pending; if there are none, only the sequence-1 office → Pending · seeded data: every type → Registrar, sequence 1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="1586" width="240" height="108" as="geometry"/></mxCell>
        <mxCell id="sub-n-P14" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P14&lt;/span&gt;&lt;br&gt;&lt;b&gt;Write audit-log entry REQUEST_SUBMITTED&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1771" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="sub-n-P15" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P15&lt;/span&gt;&lt;br&gt;&lt;b&gt;Notify in the background (failures ignored)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Student: in-app notice + live push · staff of the issuing office and every clearance office, each person once: email + in-app notice + live push&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1880" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="sub-n-P16" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;P16&lt;/span&gt;&lt;br&gt;&lt;b&gt;Success dialog: tracking number, document, fee&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;“pay at the Registrar’s Office” · “View My Request” opens the request page&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1758" width="240" height="84" as="geometry"/></mxCell>
