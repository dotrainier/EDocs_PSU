        <mxCell id="msg-n-M18" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;M18&lt;/span&gt;&lt;br&gt;&lt;b&gt;Mark the student’s messages as read&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;for every staff member, not just the viewer&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="1518" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="msg-n-M19" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;M19&lt;/span&gt;&lt;br&gt;&lt;b&gt;Any signed-in user loads a page with the bell&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E3EAF4;&quot;&gt;students and staff alike&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1694.5" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="msg-n-M20" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;M20&lt;/span&gt;&lt;br&gt;&lt;b&gt;Open a live connection for this user ID&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;held in server memory · keep-alive every 30 s&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="1688" width="240" height="84" as="geometry"/></mxCell>
