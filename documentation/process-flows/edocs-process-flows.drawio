        <mxCell id="arq-lt10" value="Data saved / status changed" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1748" y="270" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="arq-ls11" value="Background" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1642" y="304" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="arq-lt12" value="Background task (does not block the response)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1748" y="302" width="232" height="30" as="geometry"/></mxCell>
