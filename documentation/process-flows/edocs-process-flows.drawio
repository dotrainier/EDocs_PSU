        <mxCell id="ov-lt20" value="Other outcome / hand-off to another page" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1598" y="430" width="232" height="30" as="geometry"/></mxCell>
