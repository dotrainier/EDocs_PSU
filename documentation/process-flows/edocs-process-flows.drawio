        <mxCell id="ov-lt16" value="Successful outcome" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1598" y="366" width="232" height="30" as="geometry"/></mxCell>
