        <mxCell id="msg-n-M5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;M5&lt;/span&gt;&lt;br&gt;&lt;b&gt;Create an in-app notice for every staff member of the involved offices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;issuing office + every office with a clearance task · “New message on &amp;lt;tracking no.&amp;gt;” + 140-character preview · no email, no live push&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="607.5" width="240" height="125" as="geometry"/></mxCell>
