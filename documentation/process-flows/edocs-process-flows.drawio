        <mxCell id="msg-n-F4" value="&lt;b&gt;Refused (400)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="980" width="240" height="50" as="geometry"/></mxCell>
