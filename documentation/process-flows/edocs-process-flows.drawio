        <mxCell id="ov-lt8" value="System step" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1598" y="238" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="ov-ls9" value="Saved" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1492" y="272" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="ov-lt10" value="Data saved / status changed" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1598" y="270" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="ov-ls11" value="Background" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1492" y="304" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="ov-lt12" value="Background task (does not block the response)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1598" y="302" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="ov-ls13" value="?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1492" y="336" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="ov-lt14" value="Decision / check" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1598" y="334" width="232" height="30" as="geometry"/></mxCell>
