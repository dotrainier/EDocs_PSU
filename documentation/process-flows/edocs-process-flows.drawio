        <mxCell id="ov-ls3" value="Action" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1492" y="176" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="ov-lt4" value="Action by a person (actor = lane)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1598" y="174" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="ov-ls5" value="Offline" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1492" y="208" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="ov-lt6" value="Action outside the system" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1598" y="206" width="232" height="30" as="geometry"/></mxCell>
