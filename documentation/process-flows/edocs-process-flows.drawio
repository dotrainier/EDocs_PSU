  <diagram id="arq" name="4b · Action Required &amp; resubmission">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2030" pageHeight="1787" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="arq-title" value="4b · Action Required: showing the reason and resubmitting" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="arq-subtitle" value="How a request leaves Action Required: the student sees each rejecting office’s reason, fixes the issue and resubmits; the rejected task restarts as Pending in the same office’s queue." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1540" height="44" as="geometry"/></mxCell>
        <mxCell id="arq-lane0" value="Student" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="1637" as="geometry"/></mxCell>
        <mxCell id="arq-lane1" value="System" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="940" height="1637" as="geometry"/></mxCell>
        <mxCell id="arq-lane2" value="Office Staff" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1280" y="110" width="300" height="1637" as="geometry"/></mxCell>
        <mxCell id="arq-n-X1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;X1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student opens a request in Action Required&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E3EAF4;&quot;&gt;after the “Action required” notice and email (page 4, C22)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="188" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="arq-n-X2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X2&lt;/span&gt;&lt;br&gt;&lt;b&gt;Show the reason and the resubmit panel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;banner lists each rejecting office with its remark · panel: optional note, and for TOR an optional replacement clearance form&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="175" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="arq-n-X3" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X3&lt;/span&gt;&lt;br&gt;&lt;b&gt;Fixes the issue and clicks “Resubmit for clearance”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;may add a note to the office · TOR: may attach a new clearance form (PDF/JPG/PNG, max 5 MB)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="351.5" width="240" height="97" as="geometry"/></mxCell>
        <mxCell id="arq-n-X4" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X4&lt;/span&gt;&lt;br&gt;Request is theirs and still Action Required?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="502" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="arq-n-F1" value="&lt;b&gt;Refused (403 / 404 / 409)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="545" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="arq-n-X5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X5&lt;/span&gt;&lt;br&gt;Note 2,000 characters or less?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="667" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="arq-n-F2" value="&lt;b&gt;Refused (400)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="710" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="arq-n-X6" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X6&lt;/span&gt;&lt;br&gt;Any clearance task still Rejected?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="832" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="arq-n-F3" value="&lt;b&gt;Refused: “no rejected clearance to resubmit” (409)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="875" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="arq-n-X7" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X7&lt;/span&gt;&lt;br&gt;Replacement form attached?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="997" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="arq-n-X8" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X8&lt;/span&gt;&lt;br&gt;TOR request, PDF/JPG/PNG, ≤ 5 MB?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="997" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="arq-n-F4" value="&lt;b&gt;Refused: not a TOR, wrong type or too large (400)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="1040" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="arq-n-X9" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X9&lt;/span&gt;&lt;br&gt;&lt;b&gt;Upload the new form to private cloud storage&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="1191" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="arq-n-X10" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X10&lt;/span&gt;&lt;br&gt;&lt;b&gt;Save the resubmission in one transaction&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;request → Pending (only if still Action Required; a double submit is refused) · every Rejected task → Pending, remarks cleared · note posted to the message thread · new form’s file ID saved&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1298.5" width="240" height="123" as="geometry"/></mxCell>
        <mxCell id="arq-n-X11" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Write audit entry REQUEST_RESUBMITTED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;offices whose task restarted, the note, whether the form was replaced&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1473" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="arq-n-X12" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X12&lt;/span&gt;&lt;br&gt;&lt;b&gt;Notify staff of those offices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;in-app notice “Resubmitted for clearance: &amp;lt;tracking no.&amp;gt;” with a preview of the note&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1604" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="arq-n-X13" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X13&lt;/span&gt;&lt;br&gt;&lt;b&gt;Request is back to Pending&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;banner and panel disappear · timeline shows “Resubmitted for clearance”&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1610.5" width="240" height="69" as="geometry"/></mxCell>
        <mxCell id="arq-n-X14" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;X14&lt;/span&gt;&lt;br&gt;&lt;b&gt;Task reappears in the office queue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;reviewed again: continues on page 4 (C1)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="1603" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="arq-n-Xi" value="&lt;b&gt;What changes and what doesn’t&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Only Rejected tasks restart — tasks other offices already cleared stay cleared. Payment stays as confirmed. Purpose, copies and COG term can’t be edited here.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="70" y="852" width="240" height="96" as="geometry"/></mxCell>
