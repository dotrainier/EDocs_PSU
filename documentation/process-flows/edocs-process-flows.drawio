        <mxCell id="acc-ls11" value="Background" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1352" y="304" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="acc-lt12" value="Background task (does not block the response)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1458" y="302" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="acc-ls13" value="?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1352" y="336" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="acc-lt14" value="Decision / check" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1458" y="334" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="acc-ls15" value="Success" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1352" y="368" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="acc-lt16" value="Successful outcome" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1458" y="366" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="acc-ls17" value="Refused" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1352" y="400" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="acc-lt18" value="Refusal or failure outcome" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1458" y="398" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="acc-ls19" value="Other" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1352" y="432" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="acc-lt20" value="Other outcome / hand-off to another page" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1458" y="430" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="acc-ls21" value="Note" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1352" y="464" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="acc-lt22" value="Context note (confirmed behaviour)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1458" y="462" width="232" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="wiz" name="3a · Request wizard">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1729" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="wiz-title" value="3a · Filling in a document request (4-step wizard)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="wiz-subtitle" value="What the student goes through before submitting: choosing a document, entering details, the AI purpose checks, the privacy notice, and the review screen with a live completion estimate." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1210" height="44" as="geometry"/></mxCell>
        <mxCell id="wiz-lane0" value="Student" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="570" height="1579" as="geometry"/></mxCell>
        <mxCell id="wiz-lane1" value="System" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="110" width="640" height="1579" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;W1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student opens “Request a Document”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="201" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W2&lt;/span&gt;&lt;br&gt;&lt;b&gt;Load the document types this student may request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;active types granted to the Student role · “currently enrolled only” types (COE, COR) hidden from alumni&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="181.5" width="240" height="97" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W3" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W3&lt;/span&gt;&lt;br&gt;Loaded?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="675" y="332" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="wiz-n-F1" value="&lt;b&gt;“Failed to load document types”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Try again button&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="375" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W4" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W4&lt;/span&gt;&lt;br&gt;&lt;b&gt;Step 1 · Pick a document type&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;TOR, COE, COG or COR — each card shows the fee, preparation days and issuing office&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="504" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W5&lt;/span&gt;&lt;br&gt;&lt;b&gt;Step 2 · Fill in the request details&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;purpose: preset list or “Other” free text · copies 1–10 · optional notes · COG: a past school year + semester · TOR: clearance form (PDF/JPG/PNG, max 5 MB) · Continue stays disabled until these are complete&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="652" width="240" height="136" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W6" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W6&lt;/span&gt;&lt;br&gt;&lt;b&gt;Run the AI checks in parallel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Type match (always): cached result → keyword shortcut → Gemini · Purpose quality (“Other” purposes only): too short or generic = vague, otherwise Gemini · an AI error means that check is skipped&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="659.5" width="240" height="121" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W7" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W7&lt;/span&gt;&lt;br&gt;Purpose judged vague or inappropriate?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="675" y="837" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W9" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W9&lt;/span&gt;&lt;br&gt;&lt;b&gt;Show a warning dialog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Vague purpose: reason + suggestion · Type mismatch or low confidence: suggested type, confidence %, AI reasoning · the purpose warning wins if both apply&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="956" width="240" height="108" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W10" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W10&lt;/span&gt;&lt;br&gt;Edit purpose, or continue anyway?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="345" y="942" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W8" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W8&lt;/span&gt;&lt;br&gt;AI agrees with the chosen type (≥ 80% sure), or AI unavailable?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="675" y="1067" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W11" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Step 3 · Read the data-privacy notice and tick “I agree”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Continue stays disabled until ticked&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="1254.5" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W12" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W12&lt;/span&gt;&lt;br&gt;&lt;b&gt;Step 4 · Review and confirm&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;every field, the fee and the expected completion date&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="1395.5" width="240" height="69" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W13" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W13&lt;/span&gt;&lt;br&gt;&lt;b&gt;Estimate the expected completion date&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;working days from today, weekends skipped = the larger of (queued workload at the issuing office + this request) ÷ the office’s daily capacity (default 20), or the type’s minimum preparation days&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="1362" width="240" height="136" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W14" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W14&lt;/span&gt;&lt;br&gt;&lt;b&gt;Clicks “Submit Request”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="1572" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="wiz-n-W15" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;W15&lt;/span&gt;&lt;br&gt;&lt;b&gt;Continues on page 3b · Request submission&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="1571" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="wiz-n-Wi" value="&lt;b&gt;At any step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;Back returns to the previous step. Cancel → “Cancel this request?” → back to the dashboard; nothing is saved.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="1395" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="wiz-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W1" target="wiz-n-W2"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="wiz-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W2" target="wiz-n-W3"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="wiz-e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;fontColor=#B85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W3" target="wiz-n-F1"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="wiz-e3" value="Try again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#808080;fontColor=#555555;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-F1" target="wiz-n-W2"><mxGeometry x="0.00" relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="wiz-e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W3" target="wiz-n-W4"><mxGeometry x="-0.86" relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="545"/></Array></mxGeometry></mxCell>
        <mxCell id="wiz-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W4" target="wiz-n-W5"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="wiz-e6" value="Continue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W5" target="wiz-n-W6"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="wiz-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W6" target="wiz-n-W7"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="wiz-e8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W7" target="wiz-n-W9"><mxGeometry x="-0.66" relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="905"/></Array></mxGeometry></mxCell>
        <mxCell id="wiz-e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W7" target="wiz-n-W8"><mxGeometry x="0.60" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="wiz-e10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W8" target="wiz-n-W9"><mxGeometry x="-0.69" relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="1135"/></Array></mxGeometry></mxCell>
        <mxCell id="wiz-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W9" target="wiz-n-W10"><mxGeometry x="0.00" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="wiz-e12" value="Edit purpose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#1F4E79;fontColor=#1F4E79;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W10" target="wiz-n-W5"><mxGeometry x="-0.79" relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="1010"/></Array></mxGeometry></mxCell>
        <mxCell id="wiz-e13" value="Continue anyway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#404040;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wiz-n-W10" target="wiz-n-W11"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell>
