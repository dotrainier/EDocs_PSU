        <mxCell id="msg-n-M16" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;M16&lt;/span&gt;&lt;br&gt;&lt;b&gt;Mark staff messages as read; return the thread oldest first&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="1401" width="240" height="58" as="geometry"/></mxCell>
