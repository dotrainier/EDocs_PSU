        <mxCell id="wiz-lt4" value="Action by a person (actor = lane)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="174" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="wiz-ls5" value="Offline" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1312" y="208" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="wiz-lt6" value="Action outside the system" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="206" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="wiz-ls7" value="Step" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1312" y="240" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="wiz-lt8" value="System step" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="238" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="wiz-ls9" value="Saved" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1312" y="272" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="wiz-lt10" value="Data saved / status changed" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="270" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="wiz-ls11" value="Background" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1312" y="304" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="wiz-lt12" value="Background task (does not block the response)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="302" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="wiz-ls13" value="?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1312" y="336" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="wiz-lt14" value="Decision / check" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="334" width="232" height="30" as="geometry"/></mxCell>
        <mxCell id="wiz-ls15" value="Success" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1312" y="368" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="wiz-lt16" value="Successful outcome" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="366" width="232" height="30" as="geometry"/></mxCell>
