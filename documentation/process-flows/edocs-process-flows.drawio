        <mxCell id="wiz-legend" value="Legend" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="110" width="360" height="394" as="geometry"/></mxCell>
        <mxCell id="wiz-ls1" value="Start" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1312" y="144" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="wiz-lt2" value="Start / trigger" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="142" width="232" height="30" as="geometry"/></mxCell>
