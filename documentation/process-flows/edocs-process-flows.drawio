        <mxCell id="wiz-lt22" value="Context note (confirmed behaviour)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1418" y="462" width="232" height="30" as="geometry"/></mxCell>
