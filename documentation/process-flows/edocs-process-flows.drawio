        <mxCell id="ov-title" value="e-Docs — request lifecycle at a glance" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="ov-subtitle" value="End-to-end path of a document request, from account registration to release. Each block is expanded on the numbered pages that follow. Step IDs (e.g. O3) are explained with source locations in README.md." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1390" height="44" as="geometry"/></mxCell>
        <mxCell id="ov-lane0" value="Student" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="1719" as="geometry"/></mxCell>
        <mxCell id="ov-lane1" value="System" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="500" height="1719" as="geometry"/></mxCell>
        <mxCell id="ov-lane2" value="Office Staff" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="290" height="1719" as="geometry"/></mxCell>
        <mxCell id="ov-lane3" value="Admin" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1130" y="110" width="300" height="1719" as="geometry"/></mxCell>
        <mxCell id="ov-n-O1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;O1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student or alumnus registers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E3EAF4;&quot;&gt;page 1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="202" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="ov-n-O2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O2&lt;/span&gt;&lt;br&gt;&lt;b&gt;Account saved&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;verification = pending&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="202" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="ov-n-O3" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O3&lt;/span&gt;&lt;br&gt;Admin approves the registration?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1165" y="312" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ov-n-O3x" value="&lt;b&gt;Registration rejected&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;reason emailed · sign-in stays blocked&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="515" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="ov-n-O4" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O4&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student signs in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;page 2 · access checks on every page: page 2b&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="345.5" width="240" height="69" as="geometry"/></mxCell>
        <mxCell id="ov-n-O5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O5&lt;/span&gt;&lt;br&gt;&lt;b&gt;Completes the 4-step request wizard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;AI reviews the purpose · fee and expected date shown · page 3a&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="478" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="ov-n-O6" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O6&lt;/span&gt;&lt;br&gt;&lt;b&gt;Request saved — status Pending&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;tracking number issued · Registrar clearance task created · student and office staff notified · page 3b&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="639" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="ov-n-O7" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O7&lt;/span&gt;&lt;br&gt;&lt;b&gt;Staff review the request and confirm the onsite payment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;“Mark as Paid” if still unpaid · page 4&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="804.5" width="240" height="71" as="geometry"/></mxCell>
        <mxCell id="ov-n-O8" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O8&lt;/span&gt;&lt;br&gt;Clear or reject the clearance task?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="865" y="932" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ov-n-O8x" value="&lt;b&gt;Status = Action Required&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;the student sees the office’s reason · page 4b&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="971.5" width="240" height="57" as="geometry"/></mxCell>
        <mxCell id="ov-n-O8r" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O8r&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student fixes the issue and resubmits&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;optional note · TOR: optional new clearance form · page 4b&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="958" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="ov-n-O9" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O9&lt;/span&gt;&lt;br&gt;Another clearance office still has to act?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="355" y="1092" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="ov-n-O10" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O10&lt;/span&gt;&lt;br&gt;&lt;b&gt;Status = Ready for Release&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="1292" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="ov-n-O11" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Issuing office may generate the certificate PDF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;COE / COR / COG only · on demand, not stored · page 5&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="1278" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="ov-n-O12" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;O12&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student picks up the document at the office&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;outside the system&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1424.5" width="240" height="71" as="geometry"/></mxCell>
