  <diagram id="rel" name="5 · Generate &amp; release">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2008" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rel-title" value="5 · Certificate generation, pickup and release" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="rel-subtitle" value="What happens after a request is Ready for Release: optional PDF generation by the issuing office, the student’s Download button, physical pickup, and the admin closing the request." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1510" height="44" as="geometry"/></mxCell>
        <mxCell id="rel-lane0" value="Student" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="1858" as="geometry"/></mxCell>
        <mxCell id="rel-lane1" value="Office Staff" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="300" height="1858" as="geometry"/></mxCell>
        <mxCell id="rel-lane2" value="System" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="630" height="1858" as="geometry"/></mxCell>
        <mxCell id="rel-lane3" value="Admin" style="swimlane;html=1;startSize=36;collapsible=0;horizontal=1;fillColor=#DCE6F2;strokeColor=#8FA3BF;fontStyle=1;fontSize=14;fontColor=#1F3A5F;swimlaneFillColor=#FAFBFD;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="300" height="1858" as="geometry"/></mxCell>
        <mxCell id="rel-n-D1" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;D1&lt;/span&gt;&lt;br&gt;&lt;b&gt;Request is Ready for Release&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E3EAF4;&quot;&gt;from page 4&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="202" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="rel-n-D2" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D2&lt;/span&gt;&lt;br&gt;Generated type (COE, COR or COG)?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="715" y="312" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="rel-n-D2n" value="&lt;b&gt;TOR: no generation or upload step exists in the system&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="355" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="rel-n-D3" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D3&lt;/span&gt;&lt;br&gt;&lt;b&gt;Issuing-office staff clicks “Generate Document”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;panel shown only while Ready for Release&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="338" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="rel-n-D4" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D4&lt;/span&gt;&lt;br&gt;Staff’s office issues this type and request still Ready for Release?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="715" y="477" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="rel-n-F1" value="&lt;b&gt;Refused (400 / 403 / 409)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="520" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="rel-n-D5" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D5&lt;/span&gt;&lt;br&gt;&lt;b&gt;Fill the certificate template and render it as a PDF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;only the generation date is filled in · rendered fresh on every click · nothing is stored&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="656.5" width="240" height="97" as="geometry"/></mxCell>
        <mxCell id="rel-n-F2" value="&lt;b&gt;Generation error (500)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="680" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="rel-n-D6" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D6&lt;/span&gt;&lt;br&gt;&lt;b&gt;Write audit entry DOCUMENT_GENERATED&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="811" width="240" height="58" as="geometry"/></mxCell>
        <mxCell id="rel-n-D7" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D7&lt;/span&gt;&lt;br&gt;&lt;b&gt;PDF opens for the staff member&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;can be generated again at any time&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="812" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="rel-n-D8" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D8&lt;/span&gt;&lt;br&gt;&lt;b&gt;Clicks “Download” on a Ready for Release or Released request&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="963.5" width="240" height="73" as="geometry"/></mxCell>
        <mxCell id="rel-n-D9" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D9&lt;/span&gt;&lt;br&gt;&lt;b&gt;Return the fixed sample file (sample_cor.pdf)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;same file for every request · sign-in is not checked&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="958" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="rel-n-D10" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D10&lt;/span&gt;&lt;br&gt;&lt;b&gt;Sample PDF opens in a new tab&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F5F5F5;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1105" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="rel-n-D11" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Student collects the printed document at the office&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;release method shown: “Physical Pickup Only”&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1248" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="rel-n-D12" value="&lt;span style=&quot;font-size:9px;color:#C9D6EA;&quot;&gt;D12&lt;/span&gt;&lt;br&gt;&lt;b&gt;Admin opens the request (Admin › Requests)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E3EAF4;&quot;&gt;“Mark as Released” panel shows only while Ready for Release&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="1248" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="rel-n-D13" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D13&lt;/span&gt;&lt;br&gt;&lt;b&gt;Clicks “Mark as Released”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="1402" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="rel-n-D14" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D14&lt;/span&gt;&lt;br&gt;Signed in as Admin?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="995" y="1362" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="rel-n-F3" value="&lt;b&gt;Refused (403)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="1405" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="rel-n-D15" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D15&lt;/span&gt;&lt;br&gt;Status still Ready for Release?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="995" y="1527" width="230" height="136" as="geometry"/></mxCell>
        <mxCell id="rel-n-F4" value="&lt;b&gt;Refused: “not ready to be released”&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="1570" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="rel-n-D16" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D16&lt;/span&gt;&lt;br&gt;&lt;b&gt;Set status = Released&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;audit REQUEST_RELEASED&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="1722" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="rel-n-D17" value="&lt;span style=&quot;font-size:9px;color:#8A8A8A;&quot;&gt;D17&lt;/span&gt;&lt;br&gt;&lt;b&gt;Request complete — Released&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A4A4A;&quot;&gt;no further staff actions&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#5A9E57;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="1852" width="240" height="56" as="geometry"/></mxCell>
