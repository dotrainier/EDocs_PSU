# PostgreSQL connection string for the app database.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Base URL the app uses to call its own API routes.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Public base URL of the app, used to build links in emails (e.g. tracking links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign/verify login session JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=

# SMTP server host used to send emails (e.g. smtp.gmail.com for Gmail).
SMTP_HOST=

# SMTP server port (587 for TLS, 465 for SSL).
SMTP_PORT=

# SMTP account username/email used to authenticate and send mail.
SMTP_USER=

# SMTP account password or app password — for Gmail, generate one at https://myaccount.google.com/apppasswords
SMTP_PASS=

# "From" address shown on outgoing emails.
SMTP_FROM=

# Google Gemini API key for AI-assisted features (purpose validation, dashboard insights).
# Get one from Google AI Studio: https://aistudio.google.com/app/apikey
AI_API_KEY=

# Cloudinary credentials for storing uploaded clearance forms.
# Find all three on your Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
